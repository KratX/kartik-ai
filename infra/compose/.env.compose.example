# Values consumed by docker compose itself (non-secret), plus references to the
# application env file. Copy to infra/compose/.env and adjust locally.

COMPOSE_PROJECT_NAME=kartik
APP_ENV_FILE=../../.env

# host ports exposed for local development only
GATEWAY_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL superuser for the local container. The four service roles are
# created by the migration runner on first boot, not by the image.
POSTGRES_USER=kartik
POSTGRES_PASSWORD=kartik
POSTGRES_DB=kartik

# image tags for the deployment profile (Profile P) — pin by commit SHA
GATEWAY_IMAGE=kartik-gateway:local
AUTH_IMAGE=kartik-auth:local
CHAT_IMAGE=kartik-chat:local
AGENT_IMAGE=kartik-agent:local
BILLING_IMAGE=kartik-billing:local

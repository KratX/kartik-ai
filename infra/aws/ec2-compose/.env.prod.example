# Kartik.ai Profile P Production Compose Environment Template (infra/aws/ec2-compose/docker-compose.prod.yml)
# Copy to infra/aws/ec2-compose/.env.prod and populate with real secrets before running:
#   docker compose -f infra/aws/ec2-compose/docker-compose.prod.yml --env-file infra/aws/ec2-compose/.env.prod up -d --build
# Production Compose does NOT run a local `postgres` container and forbids hardcoded S2S tokens or `AUTH_PROVIDER_MODE=mock`.

# Required strong inter-service authentication token (generate with `openssl rand -hex 32`):
SERVICE_TO_SERVICE_TOKEN=REPLACE_WITH_STRONG_RANDOM_S2S_TOKEN
CHAT_TO_AGENT_TOKEN=
CHAT_TO_BILLING_TOKEN=
GATEWAY_TO_BILLING_TOKEN=
INTERNAL_CALLER_TOKEN_CHAT=

# Required pooled Neon PostgreSQL connection URIs (ADR 0004):
DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
BILLING_DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Optional per-service role-isolated Neon connection URIs (default to DATABASE_URL when omitted):
AUTH_DATABASE_URL=
CHAT_DATABASE_URL=
AGENT_DATABASE_URL=

# Direct unpooled Neon connection URI (no `-pooler` hostname) for forward-only migrations:
DIRECT_DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon scale-to-zero pool policy (10s idle timeout, max 10 connections per service):
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_MAX=10

# Required Firebase Admin credentials for production Google authentication (§6.2 & Invariant #2):
AUTH_PROVIDER_MODE=firebase
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@REPLACE_WITH_FIREBASE_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Pure Gemini AI Configuration (Cheapest high-output Flash Lite defaults):
MOCK_AI=false
IMAGE_PROVIDER=live
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
MAX_OUTPUT_TOKENS=8192

# Object Storage (postgres or Cloudflare R2 / S3):
OBJECT_STORAGE_MODE=postgres
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=assets
OBJECT_STORAGE_REGION=ap-southeast-1

# Billing (set BILLING_MODE=razorpay with live keys when enabling payments):
BILLING_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public CORS allowlist:
CORS_ALLOWED_ORIGINS=https://your-domain.example

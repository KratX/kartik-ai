# Kartik.ai Profile P Production Compose Environment Template (infra/aws/ec2-compose/docker-compose.prod.yml)
# Copy to infra/aws/ec2-compose/.env.prod and populate with your Neon PostgreSQL credentials.
# Production Compose does NOT run a local `postgres` container; all services connect to Neon PostgreSQL.

# Required pooled Neon PostgreSQL connection URIs (ADR 0004):
DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
BILLING_DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Optional per-service role-isolated Neon connection URIs (default to DATABASE_URL when omitted):
AUTH_DATABASE_URL=
CHAT_DATABASE_URL=
AGENT_DATABASE_URL=

# Direct unpooled Neon connection URI (no `-pooler` hostname) for forward-only migrations:
DIRECT_DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon scale-to-zero pool policy (10s idle timeout, max 10 connections per service):
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_MAX=10

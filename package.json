{
  "name": "kartik-ai",
  "private": true,
  "version": "4.4.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "start:local": "node scripts/start-local-stack.mjs",
    "build": "vite build",
    "build:workspaces": "node scripts/build-workspaces.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node scripts/build-workspaces.mjs && tsc --noEmit && node scripts/lint-workspace.mjs .",
    "typecheck": "node scripts/build-workspaces.mjs && tsc --noEmit",
    "test": "node scripts/build-workspaces.mjs && node --test --test-reporter=spec \"backend/**/dist/tests/*.test.js\" \"frontend/dist/tests/*.test.js\"",
    "check:env": "node scripts/check-env.mjs",
    "keys:generate": "node scripts/manage-ed25519-keys.mjs --generate",
    "keys:verify": "node scripts/manage-ed25519-keys.mjs --verify",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed-dev-data.mjs",
    "toolchain": "node scripts/check-toolchain.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "express": "^4.21.2",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}

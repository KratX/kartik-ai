{
  "name": "@kartik/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist/tsconfig.tsbuildinfo',{force:true})\" && tsc && node -e \"fs.mkdirSync('../backend/gateway/dist/tests',{recursive:true});for(const f of fs.readdirSync('dist/tests'))if(f.endsWith('.js')){const c=fs.readFileSync('dist/tests/'+f,'utf8').replaceAll('../src/','../../../../frontend/dist/src/');fs.writeFileSync('../backend/gateway/dist/tests/'+f,c);}\"",
    "typecheck": "node -e \"fs.rmSync('dist/tsconfig.tsbuildinfo',{force:true})\" && tsc",
    "lint": "node -e \"fs.rmSync('dist/tsconfig.tsbuildinfo',{force:true})\" && tsc",
    "test": "pnpm run build && node --test dist/tests/*.test.js"
  }
}

# Kartik.ai — environment template
# Copy to .env and fill in locally. NEVER commit a filled .env.
# Placeholders only: every value below is fake.

# ---------- shared ----------
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_TO_SERVICE_TOKEN=replace-with-a-long-random-value

# User-context assertion: asymmetric is preferred.
# Gateway holds the private key; services hold only the public key.
USER_CONTEXT_SIGNING_KEY=replace-with-private-key-material
USER_CONTEXT_VERIFY_KEY=replace-with-public-key-material
USER_CONTEXT_AUDIENCE=kartik-internal
USER_CONTEXT_TTL_SECONDS=60

# ---------- PostgreSQL (one database, four schemas, one role per service) ----------
# Pooled connection string used by the application. The schema is not in the URL:
# the login role's grant decides which schema it can reach.
DATABASE_URL=postgresql://kartik_chat:kartik_chat@localhost:5432/kartik
DATABASE_SCHEMA=chat

# Unpooled. Used only by the migration runner, which needs a session rather than
# a transaction. Never used by the application.
DIRECT_DATABASE_URL=postgresql://kartik:kartik@localhost:5432/kartik

# Release idle connections so Neon compute can scale to zero. Leaving this unset
# is how the 100 CU-hour monthly allowance gets exhausted by an idle demo.
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_MAX=10

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Gateway ----------
PORT_GATEWAY=8000
AUTH_SERVICE_URL=http://auth:8001
CHAT_SERVICE_URL=http://chat:8002
AGENT_SERVICE_URL=http://agent:8003
BILLING_SERVICE_URL=http://billing:8004
PUBLIC_APP_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_MS=60000
DEMO_MODE=true
DEMO_READ_ONLY=false

# ---------- Auth ----------
PORT_AUTH=8001
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
SESSION_COOKIE_NAME=kartik_session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------- Chat ----------
PORT_CHAT=8002
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
DELETION_RETENTION_DAYS=30
PURGE_CRON=0 4 * * *

# ---------- Agent ----------
PORT_AGENT=8003
AI_PROVIDER_MODE=mock
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MODEL_CHAT=
MODEL_INTENT=
MODEL_CODING=
MODEL_SEARCH_SYNTHESIS=
MODEL_VISION=
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=2000
MAX_ATTACHMENTS=3
MAX_PROVIDER_CONCURRENCY=2
MAX_REQUEST_DURATION_MS=90000
PROVIDER_TIMEOUT_MS=45000
DAILY_PROVIDER_BUDGET_CHAT=300
DAILY_PROVIDER_BUDGET_SEARCH=50
DAILY_PROVIDER_BUDGET_EMBEDDING=500

# ---------- Object storage (local MinIO defaults) ----------
OBJECT_STORAGE_MODE=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=kartik-private
MAX_UPLOAD_BYTES=10485760

# ---------- Backups (separate credentials from the app bucket) ----------
BACKUP_OBJECT_STORAGE_MODE=r2
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ---------- Billing ----------
PORT_BILLING=8004
BILLING_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Frontend (VITE_* is public in the browser bundle) ----------
VITE_API_BASE_URL=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ENABLE_MOCKS=true

# ==============================================================================
# Kartik.ai — Local & Production Environment Template (.env.example)
# ==============================================================================
# QUICK START (runs immediately on your machine with ZERO Docker / DB setup):
#   1. Copy this file to `.env`:
#        cp .env.example .env       (macOS / Linux)
#        copy .env.example .env     (Windows CMD)
#   2. Install & start:
#        pnpm install && pnpm dev
#   3. Open http://localhost:3000
#
# OPTIONAL LIVE SERVICES (uncomment & paste your own keys when ready):
#   - Live Gemini AI (all 8 agents): paste GEMINI_API_KEY and set
#     MOCK_AI=false, AI_PROVIDER_MODE=live, IMAGE_PROVIDER=live
#   - PostgreSQL persistence (Local or Neon): uncomment DATABASE_URL & DIRECT_DATABASE_URL
#   - Google Sign-In (Firebase): fill VITE_FIREBASE_* & FIREBASE_PROJECT_ID
#
# SECURITY: NEVER commit a filled `.env` file containing real secrets.
# ==============================================================================

# ---------- Runtime & Server ----------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug
TZ=UTC
DEMO_MODE=true
DEMO_READ_ONLY=false
ALLOW_ROOT_DEMO_RUNTIME=true

# ---------- Service-to-Service Auth (local dev tokens) ----------
SERVICE_TO_SERVICE_TOKEN=s2s-local-dev-token-kartik-ai-v43
INTERNAL_CALLER_TOKEN_CHAT=s2s-local-dev-token-kartik-ai-v43
CHAT_TO_AGENT_TOKEN=s2s-local-dev-token-kartik-ai-v43
CHAT_TO_BILLING_TOKEN=s2s-local-dev-token-kartik-ai-v43
GATEWAY_TO_BILLING_TOKEN=s2s-local-dev-token-kartik-ai-v43

# ---------- User-Context Assertion (Ed25519 RFC 8032 / RFC 8410) ----------
# Gateway holds the private key; downstream services hold only the public key.
# Generate fresh production keys with: pnpm keys:generate && pnpm keys:verify
USER_CONTEXT_SIGNING_KEY_FILE=infra/aws/ec2-compose/secrets/user_context_signing_key.pem
USER_CONTEXT_PUBLIC_KEY_FILE=infra/aws/ec2-compose/secrets/user_context_public_key.pem
USER_CONTEXT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIPwHyW/3kM0Z3QMGB81kUrJ5WQISn4mAtocgQgxKPH79\n-----END PRIVATE KEY-----"
USER_CONTEXT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAfchUUUJg/0cNZUilCDgsJO8mVIggPoQyntd/nxSKh3E=\n-----END PUBLIC KEY-----"
USER_CONTEXT_VERIFY_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAfchUUUJg/0cNZUilCDgsJO8mVIggPoQyntd/nxSKh3E=\n-----END PUBLIC KEY-----"
USER_CONTEXT_AUDIENCE=kartik-internal
USER_CONTEXT_TTL_SECONDS=60

# ---------- PostgreSQL (Optional for local dev — leave blank for zero-DB mode) ----------
# Leave DATABASE_URL blank to run immediately in local in-memory mode with zero DB setup.
# When you want persistent PostgreSQL hydration across restarts (Fix #2), set one of:
#
# Option A — Local PostgreSQL / Docker Compose:
# DATABASE_URL="postgresql://kartik:kartik@127.0.0.1:5432/kartik"
# DIRECT_DATABASE_URL="postgresql://kartik:kartik@127.0.0.1:5432/kartik"
# BILLING_DATABASE_URL="postgresql://kartik:kartik@127.0.0.1:5432/kartik"
#
# Option B — Neon Serverless PostgreSQL (uses strict TLS verify-full from Fix #3):
# DATABASE_URL="postgresql://<user>:<password>@ep-<your-endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT_DATABASE_URL="postgresql://<user>:<password>@ep-<your-endpoint>.<region>.aws.neon.tech/neondb?sslmode=verify-full"
# BILLING_DATABASE_URL="postgresql://<user>:<password>@ep-<your-endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL=
BILLING_DATABASE_URL=
DIRECT_DATABASE_URL=
# Optional per-service role overrides (fall back to DATABASE_URL when unset):
AUTH_DATABASE_URL=
CHAT_DATABASE_URL=
AGENT_DATABASE_URL=
DATABASE_SCHEMA=chat

# Neon scale-to-zero pool cap (must be <= 10000 ms per ADR 0004)
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_MAX=10
# Optional TLS overrides (Fix #3): leave blank to verify certificates strictly;
# set PGSSLROOTCERT=/path/to/ca.pem for private CAs, or sslmode=no-verify for self-signed dev DBs.
PGSSL_REJECT_UNAUTHORIZED=
PGSSLROOTCERT=

# ---------- Redis (Optional for local dev — leave blank for instant in-memory fallback) ----------
# Uncomment when running local Redis / Docker Compose:
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# ---------- Gateway & Microservice Ports ----------
PORT_GATEWAY=8000
AUTH_SERVICE_URL=http://127.0.0.1:8001
CHAT_SERVICE_URL=http://127.0.0.1:8002
AGENT_SERVICE_URL=http://127.0.0.1:8003
BILLING_SERVICE_URL=http://127.0.0.1:8004
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
PUBLIC_APP_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT_MS=60000

# ---------- Auth (Firebase) ----------
PORT_AUTH=8001
# Keep "mock" for local offline dev; set "firebase" when deploying with Firebase Admin credentials
AUTH_PROVIDER_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SESSION_COOKIE_NAME=kartik_session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------- Chat Service ----------
PORT_CHAT=8002
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
DELETION_RETENTION_DAYS=30
PURGE_CRON=0 4 * * *

# ---------- Agent & Gemini AI Provider (Gemini-Only) ----------
PORT_AGENT=8003
# Local default uses deterministic mock responses (zero API cost).
# To enable real Gemini AI across all 8 agents (Chat, Search, Coding, PDF, PPT, RAG, Vision, Image),
# paste your GEMINI_API_KEY and set MOCK_AI=false, AI_PROVIDER_MODE=live, IMAGE_PROVIDER=live.
AI_PROVIDER_MODE=mock
MOCK_AI=true
IMAGE_PROVIDER=mock
GEMINI_API_KEY=
# Optional Gemini model overrides (defaults: gemini-3.1-flash-lite, gemini-3.1-flash-lite-image, gemini-embedding-2)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
DAILY_LIVE_CALL_BUDGET=500

# Vector Store (leave QDRANT_URL blank to use local disk-backed vector storage with zero Docker setup)
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_URL=
QDRANT_API_KEY=

MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=8192
MAX_ATTACHMENTS=3
MAX_PROVIDER_CONCURRENCY=2
MAX_REQUEST_DURATION_MS=90000
PROVIDER_TIMEOUT_MS=45000
DAILY_PROVIDER_BUDGET_CHAT=300
DAILY_PROVIDER_BUDGET_SEARCH=50
DAILY_PROVIDER_BUDGET_EMBEDDING=500

# ---------- Object Storage (Filesystem / S3 / R2 / MinIO / PostgreSQL) ----------
# Modes:
#   "filesystem" (recommended for local dev — stores uploads & artifacts locally with zero cloud setup)
#   "memory"     (ephemeral in-memory storage for tests)
#   "postgres"   (stores binary objects in PostgreSQL private_objects table)
#   "s3"         (S3-compatible bucket when AWS_ENDPOINT_URL_S3 or OBJECT_STORAGE_ENDPOINT is configured)
OBJECT_STORAGE_MODE=filesystem
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=assets
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=assets
OBJECT_STORAGE_REGION=ap-southeast-1
MAX_UPLOAD_BYTES=10485760

# ---------- Backups (separate credentials from the app bucket) ----------
BACKUP_OBJECT_STORAGE_MODE=r2
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ---------- Billing (Mock by default; Razorpay test mode optional) ----------
PORT_BILLING=8004
BILLING_MODE=mock
# Use rzp_test_* keys only on local/demo deployments (rzp_live_* is blocked by check:env)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Frontend (VITE_* variables are exposed to the browser bundle) ----------
VITE_API_BASE_URL=/api/v1
VITE_GATEWAY_ORIGIN=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_ENABLE_MOCKS=true

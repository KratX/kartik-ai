# Kartik.ai — environment template
# Copy to .env and fill in locally. NEVER commit a filled .env.
# Placeholders only: every value below is fake.

# ---------- shared ----------
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_TO_SERVICE_TOKEN=s2s-local-dev-token-kartik-ai-v43
INTERNAL_CALLER_TOKEN_CHAT=s2s-local-dev-token-kartik-ai-v43
CHAT_TO_AGENT_TOKEN=s2s-local-dev-token-kartik-ai-v43
CHAT_TO_BILLING_TOKEN=s2s-local-dev-token-kartik-ai-v43
GATEWAY_TO_BILLING_TOKEN=s2s-local-dev-token-kartik-ai-v43

# User-context assertion: asymmetric Ed25519 (RFC 8032).
# Gateway holds the private key; services hold only the public key.
USER_CONTEXT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIFlocalDevEd25519SeedForKartikAiGateway01\n-----END PRIVATE KEY-----"
USER_CONTEXT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAlocalDevEd25519PublicKeyForKartikAiServices0\n-----END PUBLIC KEY-----"
USER_CONTEXT_VERIFY_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAlocalDevEd25519PublicKeyForKartikAiServices0\n-----END PUBLIC KEY-----"
USER_CONTEXT_AUDIENCE=kartik-internal
USER_CONTEXT_TTL_SECONDS=60

# ---------- PostgreSQL (Cloud SQL Object Method + Schema Isolation) ----------
SQL_HOST=/cloudsql/instance-connection-name
SQL_DB_NAME=postgres
SQL_USER=ai_studio_app
SQL_PASSWORD=placeholder_app_password
SQL_ADMIN_USER=ai_studio_admin
SQL_ADMIN_PASSWORD=placeholder_admin_password
DATABASE_SCHEMA=chat

# Release idle connections so compute can scale to zero.
PGPOOL_IDLE_TIMEOUT_MS=10000
PGPOOL_MAX=10

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Gateway ----------
PORT_GATEWAY=8000
AUTH_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT_MS=60000
DEMO_MODE=true
DEMO_READ_ONLY=false

# ---------- Auth ----------
PORT_AUTH=8001
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
SESSION_COOKIE_NAME=kartik_session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------- Chat ----------
PORT_CHAT=8002
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
DELETION_RETENTION_DAYS=30
PURGE_CRON=0 4 * * *

# ---------- Agent ----------
PORT_AGENT=8003
AI_PROVIDER_MODE=mock
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MODEL_CHAT=
MODEL_INTENT=
MODEL_CODING=
MODEL_SEARCH_SYNTHESIS=
MODEL_VISION=
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=2000
MAX_ATTACHMENTS=3
MAX_PROVIDER_CONCURRENCY=2
MAX_REQUEST_DURATION_MS=90000
PROVIDER_TIMEOUT_MS=45000
DAILY_PROVIDER_BUDGET_CHAT=300
DAILY_PROVIDER_BUDGET_SEARCH=50
DAILY_PROVIDER_BUDGET_EMBEDDING=500

# ---------- Object storage (Neon S3-Compatible Storage / R2 / MinIO / PostgreSQL) ----------
# Modes: "s3" (uses S3CompatibleObjectStorage when AWS_ENDPOINT_URL_S3 or OBJECT_STORAGE_ENDPOINT is set),
#        "postgres" (stores binary objects in PostgreSQL private_objects table),
#        "filesystem" (uses OS temp directory), or "memory" (in-memory only).
OBJECT_STORAGE_MODE=s3
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=assets
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=assets
OBJECT_STORAGE_REGION=ap-southeast-1
MAX_UPLOAD_BYTES=10485760

# ---------- Backups (separate credentials from the app bucket) ----------
BACKUP_OBJECT_STORAGE_MODE=r2
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ---------- Billing ----------
PORT_BILLING=8004
BILLING_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Frontend (VITE_* is public in the browser bundle) ----------
VITE_API_BASE_URL=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ENABLE_MOCKS=true

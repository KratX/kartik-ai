{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "auth/**/*.ts",
    "config/**/*.ts",
    "contracts/**/*.ts",
    "database/**/*.ts",
    "errors/**/*.ts",
    "logger/**/*.ts",
    "middleware/**/*.ts",
    "redis/**/*.ts",
    "storage/**/*.ts",
    "validation/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
